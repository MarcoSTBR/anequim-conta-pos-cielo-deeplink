<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.com.st.anequimconta_stand_dl1.activity.ActivityProdutoAdd">

    <LinearLayout
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/rodape"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:background="@drawable/edit_customizado"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/descricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="5dp"
                        android:text="PRODUTO 12112 1212 1212 121212"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/mais"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:background="@drawable/text_customizado"
                        android:layout_below="@id/descricao"
                        android:layout_marginLeft="20dp"
                        android:src="@drawable/ic_mais_1" />

                    <ImageButton
                        android:id="@+id/menos"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:background="@drawable/text_customizado"
                        android:layout_below="@id/descricao"
                        android:layout_alignParentEnd="true"
                        android:layout_marginRight="20dp"
                        android:src="@drawable/ic_menos_1" />

                    <TextView
                        android:id="@+id/quantidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/descricao"
                        android:layout_marginTop="5dp"
                        android:layout_toStartOf="@+id/menos"
                        android:layout_toEndOf="@id/mais"
                        android:text="1"
                        android:textAlignment="center"
                        android:textSize="30dp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/layout_acompanhamento"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/grade_acompanhamento"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:listitem="@layout/layout_grade_acompanhamemto"
                        />

                </LinearLayout>
            </LinearLayout>

        </ScrollView>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rodape"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:background="@color/principal">

        <Button
            android:id="@+id/voltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/produto_botao_voltar"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/precoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="10dp"
            android:text="@string/produto_botao_add"
            android:textAllCaps="false" />
    </RelativeLayout>

</RelativeLayout>