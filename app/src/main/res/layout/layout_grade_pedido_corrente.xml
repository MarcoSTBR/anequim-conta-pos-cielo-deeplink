<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/grade_customizado"
    >

    <ImageButton
        android:id="@+id/bt_delete"
        android:layout_marginLeft="5dp"
        android:layout_width="50dp"
        android:layout_height="90dp"
        android:background="@drawable/botao_customizado"
        app:srcCompat="@drawable/ic_lixeira" />

    <TextView

        android:id="@+id/num_pedido"
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/bt_delete"
        android:layout_toStartOf="@id/bt_ir"
        android:text="10"
        android:textSize="40dp"
        android:textStyle="bold"
        android:textAlignment="center" />
    <TextView
        android:id="@+id/num_itens"
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/bt_delete"
        android:layout_toStartOf="@id/bt_ir"
        android:layout_below="@id/num_pedido"
        android:text="Iten(s) 8"
        android:textStyle="bold"
        android:textAlignment="center" />

    <ImageButton
        android:id="@+id/bt_ir"
        android:layout_marginRight="5dp"
        android:layout_width="50dp"
        android:layout_height="90dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/botao_customizado"
        app:srcCompat="@drawable/ic_play" />
</RelativeLayout>