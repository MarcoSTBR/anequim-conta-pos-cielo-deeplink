<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data android:scheme="lio" />
        </intent>
        <intent>
            <action android:name="cielo.orders.v3.ORDER_MANAGER_SERVICE" />
        </intent>
        <intent>
            <action android:name="cielo.orders.v3.PAYMENT_SERVICE" />
        </intent>

        <package android:name="com.cielo.lio" />
        <package android:name="com.cielo.lio.ordermanager" />
        <package android:name="com.cielo.pay" />
        <package android:name="com.cielo.orders" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo_st2"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo_st2"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnequimContaPOS.NoActionBar"
        android:usesCleartextTraffic="true"
        tools:replace="android:icon,roundIcon,android:theme"
        tools:targetApi="31">
        <activity
            android:name=".activity.ActivityItemObs"
            android:exported="false" />

        <service
            android:name="com.cielo.ordermanager.sdk.sample.services.DeepLinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:ignore="ForegroundServicePermission" />

        <activity
            android:name=".activity.ActivityReimprimir"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="reprint"
                    android:scheme="@string/scheme_caixa_return" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.ActivityCancelamento"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="cancel"
                    android:scheme="@string/scheme_return_capture" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".pospag.payCielo.receiver.LIOCancelationBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="cielo.action.NOTIFY_TRANSACTION_CANCEL" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".activity.ActivityCaptura"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:host="@string/intent_host"
                    android:scheme="@string/intent_scheme_same_activity" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.ActivityImpressao"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="impressao"
                    android:scheme="anequim_stand" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.ActivityConfigucacoesOperacionais"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityConfiguracaoNfce"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityQrCodeTicket"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityImprimirContas"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityPainelContas"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityEnvioPedidos"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityConfiguracao"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityProdutoAdd"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityTerminal"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityLogin"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityRegistro"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityAddPedido"
            android:exported="false" />
        <activity
            android:name=".activity.ActivityPrincipal"
            android:exported="false"
            android:theme="@style/Theme.AnequimContaPOS.NoActionBar" />
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
        <activity
            android:name=".activity.ActivityEntrada"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>