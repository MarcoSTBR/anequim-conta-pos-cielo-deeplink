<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="br.com.st.anequimconta_stand_dl1.activity.ActivityEnvioPedidos">

    <TextView
        android:id="@+id/txtmensagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ambiente"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <ImageView
        android:id="@+id/bitmensagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_conta_print"
        android:gravity="center"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grade_ambiente"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        tools:itemCount="3"
        tools:listitem="@layout/layout_grade_ambiente" />


</LinearLayout>