<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="br.com.st.anequimconta_stand_dl1.ui.FragmentConta">
    <RelativeLayout
        android:id="@+id/layout_pedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/grade_customizado"
        >
        <TextView
            android:id="@+id/pedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="5dp"
            android:text="Conta->"
            android:textSize="30dp"
            android:gravity="center"
            android:layout_toStartOf="@id/bt_add_pedido"

            />
        <ImageButton
            android:id="@+id/bt_add_pedido"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_mais"
            android:layout_alignParentEnd="true"
            android:background="@drawable/botao_customizado"
            />
    </RelativeLayout>
    >
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grade_contas_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        tools:itemCount="10"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/layout_conta_bitmap" />


</LinearLayout>