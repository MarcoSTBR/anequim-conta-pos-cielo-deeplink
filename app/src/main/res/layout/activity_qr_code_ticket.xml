<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context="br.com.st.anequimconta_stand_dl1.activity.ActivityQrCodeTicket">

<TextView
    android:id="@+id/textView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/qrcode_text"
    android:textStyle="bold"
    android:textAlignment="center"
    android:layout_marginTop="20dp"
    />
<ImageView
    android:id="@+id/imageViewCod"
    android:layout_width="match_parent"
    android:layout_height="174dp"
    android:layout_marginTop="10sp"
    app:srcCompat="@drawable/ic_code_scanner_24"
    android:layout_below="@id/textView"/>

<TextView
    android:id="@+id/textRetorno"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@id/imageViewCod"
    android:layout_alignBottom="@id/buttonSair"
    android:text=""
    android:textAlignment="center"
    android:gravity="center"
    android:textStyle="bold"
    android:background="@drawable/back_verde"
    android:textSize="20dp"/>

<Button
    android:id="@+id/buttonSair"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/botao_customizado"
    android:layout_alignParentBottom="true"
    android:gravity="center"
    android:layout_marginBottom="20dp"
    android:layout_marginLeft="30dp"
    android:layout_marginRight="30dp"
    android:textColor="@color/colorBranco"
    android:textSize="20dp"
    android:text="Sair" />
</RelativeLayout>