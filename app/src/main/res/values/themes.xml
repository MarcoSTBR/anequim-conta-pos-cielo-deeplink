<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- <style name="Theme.AnequimContaPOS" parent="Theme.MaterialComponents.DayNight.DarkActionBar"> -->
     <style name="Theme.AnequimContaPOS" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
         <!-- Primary brand color. -->
        <item name="colorPrimary">@color/principal</item>
        <item name="colorPrimaryVariant">@color/secondaria</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

    </style>


    <style name="Theme.AnequimContaPOS.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AnequimContaPOS.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.AnequimContaPOS.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ThemeBotaoGrade" patent="Theme.MaterialComponents.Light.NoActionBar"/>

    <style name="ThemeActiveDrawer" patent="Theme.MaterialComponents.Light.NoActionBar"/>


    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="android:background">@color/principal</item>
        <item name="colorOnPrimary">@color/purple_200</item>
    </style>

    <style name="CustomTabGrade" parent="TextAppearance.AppCompat">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CustomTabGradeSelecionado" parent="TextAppearance.AppCompat">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/principal</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>