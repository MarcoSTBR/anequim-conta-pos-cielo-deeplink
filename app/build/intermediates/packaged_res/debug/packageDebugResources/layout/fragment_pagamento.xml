<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="br.com.st.anequimconta_stand_dl1.ui.FragmentPagamento">
    <RelativeLayout
        android:id="@+id/layout_pedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/grade_customizado"
        >
        <TextView
            android:id="@+id/pedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="5dp"
            android:text="Pedidos"
            android:textSize="30dp"
            android:gravity="center"
            android:layout_toStartOf="@id/bt_add_pedido"

            />
        <ImageButton
            android:id="@+id/bt_add_pedido"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_mais"
            android:layout_alignParentEnd="true"
            android:background="@drawable/botao_customizado"
            />
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_cabecalho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:layout_below="@id/layout_pedido">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recebimento_apagar"
            android:textAlignment="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_valor_apagar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="@id/parcial"
            android:layout_marginTop="5dp"
            android:text="R$ 0.00"
            android:textAlignment="center"
            android:textSize="60dp" />

        <ImageButton
            android:id="@+id/parcial"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/botao_customizado"
            android:src="@drawable/ic_edit" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_below="@id/layout_cabecalho"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_valor_parcial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layout_cabecalho"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/resumo_Pagamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TOTAL R$ 0.00"
                    android:textSize="25dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grade_pagamentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:itemCount="2"
                    tools:listitem="@layout/layout_grade_resumo_pagamento" />

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grade_modalidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:itemCount="2"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/layout_grade_modalidade" />
            </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>